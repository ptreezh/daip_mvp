# --- Together.ai 配置 ---
TOGETHER_API_URL=https://api.together.xyz/v1/chat/completions


# --- OpenRouter 配置 ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions


# --- SiliconFlow 配置 ---
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions


# === 安全配置 ===
# 允许的CORS域名，用逗号分隔（生产环境请限制为具体域名）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501
# 环境类型：development, staging, production
ENVIRONMENT=development



# 云端模型使用配置
USE_CLOUD_MODELS=true
CLOUD_FALLBACK=true
PREFERRED_CLOUD_PROVIDER=qiniu
CLOUD_MAX_RETRIES=3
CLOUD_TIMEOUT=30

# 本地模型配置
CHAT_MODEL=gemma3:latest
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=8192
CHAT_TIMEOUT=30
CHAT_MAX_RETRIES=3
CHAT_RETRY_DELAY=1.0

# 向量数据库配置 - 仅使用本地Ollama嵌入模型
VECTOR_DB_TYPE=chroma
VECTOR_DIMENSION=768  # nomic-embed-text的向量维度
SIMILARITY_THRESHOLD=0.7
MAX_SEARCH_RESULTS=20
# 嵌入模型配置 - 仅使用本地Ollama
EMBEDDING_API_TYPE=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/daip.log
