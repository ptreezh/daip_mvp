# DAIP Backend Configuration

# Database Configuration
DATABASE_URL=postgresql+asyncpg://daip:daip@localhost:5432/daip_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Vector Store Configuration
VECTOR_STORE_PERSIST_DIRECTORY=./data/vector_store
VECTOR_STORE_COLLECTION_NAME=daip_knowledge

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Application Configuration
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=DAIP Backend
APP_VERSION=1.0.0

# Security Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Session Configuration
SESSION_MAX_DURATION_HOURS=24
SESSION_MAX_TASKS=50
SESSION_MAX_MESSAGES=1000

# Task Configuration
TASK_MAX_CONCURRENT=10
TASK_MAX_QUEUE_SIZE=100
TASK_TIMEOUT_SECONDS=1800

# WebSocket Configuration
WEBSOCKET_CONNECTION_TIMEOUT_MINUTES=30
WEBSOCKET_PING_INTERVAL_SECONDS=30
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5

# Performance Configuration
MAX_WORKERS=4
MAX_REQUESTS_PER_WORKER=1000
REQUEST_TIMEOUT_SECONDS=300

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL_SECONDS=30

# Feature Flags
ENABLE_VECTOR_SEARCH=true
ENABLE_CACHING=true
ENABLE_STREAMING=true
ENABLE_TOOL_USE=true
ENABLE_RETRY_MECHANISM=true

# Development Configuration
DEVELOPMENT_MODE=false
ENABLE_SWAGGER=true
ENABLE_REDOC=true
AUTO_RELOAD=true

# Logging Configuration
LOG_FILE=./logs/daip.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG