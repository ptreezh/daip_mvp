{
  "mcpServers": {
    "Context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "get_context",
        "search_context", 
        "analyze_codebase",
        "get_file_info",
        "search_files",
        "get_repository_map",
        "search_code"
      ]
    }
  }
}