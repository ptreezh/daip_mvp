  "usage": {
    "cli_creation": {
      "command": "spec-create cli-command <command_name> <output_file>",
      "description": "创建CLI命令规范文档",
      "template": "cli-command-specification"
    },
    "api_creation": {
      "command": "spec-create api <api_name> <output_file>",
      "description": "创建API规范文档",
      "template": "api-specification"
    },
    "requirements_creation": {
      "command": "spec-create requirements <project_name> <output_file>",
      "description": "创建需求规格说明书",
      "template": "requirements-specification"
    },
    "project_plan_creation": {
      "command": "spec-create project-plan <project_name> <output_file>",
      "description": "创建项目计划书",
      "template": "project-plan-specification"
    },
    "task_breakdown_creation": {
      "command": "spec-create task-breakdown <project_name> <output_file>",
      "description": "创建任务分解清单",
      "template": "task-breakdown-template"
    }
  },
  "validation_rules": {
    "required_sections": {
      "cli-command": [
        "功能定义",
        "输出格式规范",
        "技术实现要求",
        "命令行选项"
      ],
      "api-specification": [
        "API概述",
        "接口定义",
        "数据模型",
        "错误处理"
      ],
      "requirements": [
        "项目概述",
        "功能需求",
        "非功能需求",
        "验收标准"
      ],
      "project-plan": [
        "项目概述",
        "技术架构",
        "项目时间线",
        "团队分工",
        "风险管理",
        "质量管理"
      ],
      "task-breakdown": [
        "项目总览",
        "阶段划分",
        "任务清单",
        "风险管理",
        "质量指标"
      ]
    },
    "quality_checks": {
      "no_ambiguous_terms": "避免使用模糊不清的术语",
      "measurable_criteria": "所有验收标准必须可测量",
      "complete_error_handling": "必须包含完整的错误处理方案",
      "performance_requirements": "必须明确性能指标和要求",
      "risk_assessment": "必须包含风险识别和缓解措施",
      "resource_planning": "必须包含详细的人力和技术资源计划"
    }
  },
  "integration": {
    "ci_cd": {
