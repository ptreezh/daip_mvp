#### 2.{{ loop.index }}.3 请求示例

{% if endpoint.method == "GET" %}
```bash
curl -X GET "{{ base_url }}{{ endpoint.path }}{% if endpoint.query_params %}?{% for param in endpoint.query_params %}{{ param.name }}={{ param.example }}{% if not loop.last %}&{% endif %}{% endfor %}{% endif %}" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer <token>"
```
{% elif endpoint.method == "POST" %}
```bash
curl -X POST "{{ base_url }}{{ endpoint.path }}" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer <token>" \
  -d '{
{% if endpoint.request_body %}
{% for key, value in endpoint.request_body.items() %}
    "{{ key }}": {{ value | tojson }}{% if not loop.last %},{% endif %}
{% endfor %}
{% endif %}
  }'
```
{% elif endpoint.method == "PUT" %}
```bash
curl -X PUT "{{ base_url }}{{ endpoint.path }}" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer <token>" \
  -d '{
{% if endpoint.request_body %}
{% for key, value in endpoint.request_body.items() %}
    "{{ key }}": {{ value | tojson }}{% if not loop.last %},{% endif %}
{% endfor %}
{% endif %}
  }'
```
{% elif endpoint.method == "DELETE" %}
```bash
curl -X DELETE "{{ base_url }}{{ endpoint.path }}{% if endpoint.query_params %}?{% for param in endpoint.query_params %}{{ param.name }}={{ param.example }}{% if not loop.last %}&{% endif %}{% endfor %}{% endif %}" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer <token>"
```
{% endif %}

