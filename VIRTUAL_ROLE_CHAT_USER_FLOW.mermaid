```mermaid
graph TD
    A[用户启动CLI] --> B{是否存在当前聊天室?};
    B -- 是 --> C[显示当前聊天室信息];
    B -- 否 --> D[处于个人助手场景];
    
    D --> E[用户输入命令];
    E --> F{命令类型};
    
    F --> G[启动新聊天室 (chat start)];
    G --> H[输入主题?];
    H -- 是 --> I[系统推荐角色];
    H -- 否 --> J[使用默认配置];
    I --> K[用户选择/创建角色?];
    K -- 否 --> L[使用推荐或默认角色];
    K -- 是 --> M[用户选择/创建角色];
    M --> N[选择/创建规则?];
    N -- 否 --> O[使用默认规则];
    N -- 是 --> P[选择/创建规则];
    P --> Q[上传文档?];
    Q --> R[创建聊天室];
    R --> S[设置为当前聊天室];
    S --> C;
    
    F --> T[发送消息 (chat message)];
    T --> U{是否指定房间?};
    U -- 否 --> V[发送到当前聊天室];
    U -- 是 --> W[发送到指定聊天室];
    V --> X[ChatCoordinator处理消息];
    W --> X;
    X --> Y[显示响应];
    Y --> C;
    
    F --> Z[查看历史 (chat history)];
    Z --> AA{是否指定房间?};
    AA -- 否 --> AB[查看当前聊天室历史];
    AA -- 是 --> AC[查看指定聊天室历史];
    AB --> AD[显示历史];
    AC --> AD;
    AD --> C;
    
    F --> AE[清除消息 (chat clear)];
    AE --> AF{是否指定房间?};
    AF -- 否 --> AG[清除当前聊天室消息];
    AF -- 是 --> AH[清除指定聊天室消息];
    AG --> AI[确认清除];
    AH --> AI;
    AI --> C;
    
    F --> AJ[关闭聊天室 (chat close)];
    AJ --> AK[确认关闭];
    AK --> AL[聊天室归档];
    AL --> AM[回到个人助手场景];
    AM --> D;
    
    F --> AN[删除聊天室 (chat delete)];
    AN --> AO[确认删除];
    AO --> AP[永久删除聊天室];
    AP --> AQ{删除的是当前房间?};
    AQ -- 是 --> AR[清除当前房间设置];
    AR --> D;
    AQ -- 否 --> C;
    
    F --> AS[聊天室内操作<br/> (上传文档, 管理角色, 更改规则等)];
    AS --> AT[ChatCoordinator处理操作];
    AT --> AU[显示操作结果];
    AU --> C;
    
    F --> AV[查看共识/分歧<br/> (特殊指令)];
    AV --> AW[ChatCoordinator调用智能助手服务];
    AW --> AX[显示共识/分歧信息];
    AX --> C;
    
    F --> AY[其他个人助手命令<br/> (pa *, debate *, wiki *)];
    AY --> AZ[执行相应命令];
    AZ --> D;
    
    C --> E;
```