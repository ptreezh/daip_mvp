        title = args_list[0]
        tags = []

        # Parse tags option
        if "--tags" in args_list:
            tags_index = args_list.index("--tags")
            if tags_index + 1 < len(args_list):
                tags = [tag.strip() for tag in args_list[tags_index + 1].split(",")]

        self._update_log_view(f"[bold blue]> 🤖 协作创建Wiki页面: '{title}'[/bold blue]")
