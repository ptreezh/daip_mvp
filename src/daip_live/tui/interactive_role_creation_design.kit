def test_simple_ai_role_generator():
    """测试AI角色生成器"""
    # 使用模拟AI提供商测试
    mock_provider = MockLLMProvider()
    generator = SimpleAIRoleGenerator(mock_provider)
    
    result = generator.generate_role_from_description("数据分析师")
    
    assert "name" in result
    assert "persona" in result
    assert isinstance(result["tools"], list)

