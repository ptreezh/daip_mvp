def parse_instruction(instruction: str):
    # 简单规则/可扩展为大模型解析
    import re

    entry = ""
    topic = ""
    rounds = 3
    m = re.search(r"协同编辑[“\"']?(.*?)[”\"']?词条|页面", instruction)
    if m:
        entry = m.group(1)
    m2 = re.search(r"聚焦(.*?)(，|,|。|$)", instruction)
    if m2:
        topic = m2.group(1)
    m3 = re.search(r"持续(\d+)轮", instruction)
    if m3:
        rounds = int(m3.group(1))
    if not entry:
        entry = "默认词条"
    if not topic:
        topic = "综合分析"
    return entry, topic, rounds


def match_experts(topic: str, n=3):
    # 简单关键词匹配，可扩展为embedding
    selected = []
    for expert in EXPERT_POOL:
        if any(tag in topic for tag in expert["tags"]):
            selected.append({"name": expert["name"], "fit_score": 5})
    if not selected:
        selected = [{"name": e["name"], "fit_score": 5} for e in EXPERT_POOL[:n]]
    return selected


