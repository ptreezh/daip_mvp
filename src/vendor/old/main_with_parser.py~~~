        "评价",
        "判断",
    ]

    # 计算匹配分数
    creation_score = sum(1 for keyword in creation_keywords if keyword in user_request)
    analysis_score = sum(1 for keyword in analysis_keywords if keyword in user_request)

    # 匹配的关键词
    matched_creation = [kw for kw in creation_keywords if kw in user_request]
    matched_analysis = [kw for kw in analysis_keywords if kw in user_request]

    # 决策逻辑
    if creation_score > analysis_score:
        task_type = "content_creation"
        confidence = (
            creation_score / (creation_score + analysis_score)
            if (creation_score + analysis_score) > 0
            else 0.5
        )
        decision_reason = f"检测到{creation_score}个创作关键词，{analysis_score}个分析关键词"

        recommended_workflow = {
            "stages": ["需求分析", "大纲设计", "内容创作", "专家评审", "修订完善", "最终发布"],
            "features": ["多专家协作", "分阶段创作", "版本管理", "质量控制", "协作编辑"],
        }
    else:
        task_type = "document_analysis"
        confidence = (
            analysis_score / (creation_score + analysis_score)
            if (creation_score + analysis_score) > 0
