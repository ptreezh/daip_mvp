def get_cors_origins():
    """从环境变量获取允许的CORS域名"""
    allowed_origins = os.getenv(
        "ALLOWED_ORIGINS",
        "http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501",
    )
    environment = os.getenv("ENVIRONMENT", "development")

    if environment == "production":
        # 生产环境严格限制域名
        origins = [
            origin.strip()
            for origin in allowed_origins.split(",")
            if origin.strip() and not origin.strip() == "*"
        ]
        if not origins:
            origins = ["https://yourdomain.com"]  # 默认安全配置
        return origins
    else:
        # 开发环境允许配置的域名
        return [origin.strip() for origin in allowed_origins.split(",")]


