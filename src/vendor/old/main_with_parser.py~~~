@app.delete("/virtual_team/project/{project_id}")
async def delete_virtual_project(project_id: str):
    """Delete a virtual team project by project ID.

    Args:
    ----
        project_id: The ID of the project to delete.

    Returns:
    -------
        JSON with success message.
    """
    if not virtual_team_engine:
        raise HTTPException(status_code=500, detail="虚拟团队引擎未初始化")
    try:
        if project_id in virtual_team_engine.projects:
            # 删除项目相关的任务
            tasks_to_delete = [
                task_id
                for task_id, task in virtual_team_engine.tasks.items()
                if task.project_id == project_id
            ]
            for task_id in tasks_to_delete:
                del virtual_team_engine.tasks[task_id]
            # 删除项目
            del virtual_team_engine.projects[project_id]
            # 删除相关的角色上下文
            contexts_to_delete = [
                key
                for key in virtual_team_engine.role_contexts.keys()
                if key.startswith(f"{project_id}_")
            ]
            for key in contexts_to_delete:
                del virtual_team_engine.role_contexts[key]
            return {"success": True, "message": "项目删除成功"}
        else:
            raise HTTPException(status_code=404, detail="项目不存在")
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"删除项目失败: {str(e)}")


