@app.get("/schemas")
async def list_schemas(
    domain: Optional[str] = None,
    search: Optional[str] = None,
    limit: int = 50,
    offset: int = 0,
):
    """获取schema列表"""
    schemas = schema_library.schemas.copy()

    # 按领域筛选
    if domain:
        schemas = [s for s in schemas if s.get("domain") == domain]

    # 搜索筛选
    if search:
        search_lower = search.lower()
        schemas = [
            s
            for s in schemas
            if search_lower in s.get("name", "").lower()
            or search_lower in s.get("description", "").lower()
            or any(search_lower in tag.lower() for tag in s.get("tags", []))
        ]

    # 分页
    total = len(schemas)
    schemas = schemas[offset : offset + limit]

    return {
        "schemas": schemas,
        "total": total,
        "limit": limit,
        "offset": offset,
        "domains": list(schema_library.schema_categories.keys()),
    }


