            "features": ["智能信息提取", "结构化输出", "溯源支持", "多格式支持", "实时处理"],
        }

    # 如果分数相等，根据特定模式判断
    if creation_score == analysis_score:
        if any(word in user_request for word in ["论文", "报告", "方案", "教材"]):
            task_type = "content_creation"
            confidence = 0.6
        elif any(word in user_request for word in ["财务", "合同", "数据", "文档"]):
            task_type = "document_analysis"
            confidence = 0.6
        else:
            confidence = 0.5

    return {
        "success": True,
        "task_type": task_type,
        "confidence": confidence,
        "classification_info": {
            "decision_reason": decision_reason,
            "creation_score": creation_score,
