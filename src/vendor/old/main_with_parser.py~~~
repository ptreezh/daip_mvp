async def update_schema(schema_id: str, schema_data: dict):
    """更新schema"""
    import json
    from datetime import datetime

    # 查找schema
    schema_index = next(
        (i for i, s in enumerate(schema_library.schemas) if s["id"] == schema_id), None
    )
    if schema_index is None:
        raise HTTPException(status_code=404, detail="Schema not found")

    schema = schema_library.schemas[schema_index]

    # 更新schema信息
    for key, value in schema_data.items():
        if key != "id":  # 不允许修改ID
            schema[key] = value

    schema["updated_at"] = datetime.now().isoformat()
    schema["tags"] = schema_library._extract_tags_from_schema(schema.get("content", {}))

    # 更新文件
    if "content" in schema_data and schema.get("file_path"):
        try:
            with open(schema["file_path"], "w", encoding="utf-8") as f:
                json.dump(schema["content"], f, ensure_ascii=False, indent=2)
        except Exception as e:
            logger.error(f"更新schema文件失败: {e}")

    return {"success": True, "schema": schema}


