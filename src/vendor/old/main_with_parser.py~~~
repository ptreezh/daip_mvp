def get_text_embedding(text: str) -> list:
    """使用本地Ollama模型生成文本嵌入向量"""
    try:
        import requests

        from src.utils import load_config

        config = load_config()
        embedding_model = config.get("embedding_model", "nomic-embed-text:latest")
        ollama_base_url = config.get("ollama_base_url", "http://localhost:11434")

        url = f"{ollama_base_url}/api/embeddings"
        payload = {"model": embedding_model, "prompt": text}

        response = requests.post(url, json=payload, timeout=10)
        response.raise_for_status()
        return response.json()["embedding"]

    except Exception as e:
        print(f"Error generating embedding with Ollama: {e}")
        # 降级到hash模拟（仅用于开发测试）
        # 修复：使用768维以匹配nomic-embed-text模型
        np.random.seed(abs(hash(text)) % (2**32))
        return (np.random.rand(768) * 2 - 1).tolist()


def build_role_embeddings():
    """为所有角色生成embedding并缓存到ALL_ROLES_DETAILS['embedding']"""
    for name, info in ALL_ROLES_DETAILS.items():
        text = info.get("desc", "") + " " + name + " " + " ".join(info.get("tags", []))
        info["embedding"] = get_text_embedding(text)
        upsert_role_to_vector_db(info)  # 同步入库到向量数据库


# 角色向量入库
def upsert_role_to_vector_db(role: dict):
    # 需保证role有name, desc, tags, embedding字段
    doc_id = role["name"]
    text = (
        role.get("desc", "") + " " + role["name"] + " " + " ".join(role.get("tags", []))
    )
    # 这里用hash embedding，实际应替换为真实embedding
    emb = get_text_embedding(text)
    role_collection.upsert(
        ids=[doc_id], embeddings=[emb], documents=[json.dumps(role, ensure_ascii=False)]
    )


# 检索最相关角色
def search_roles_by_vector(query: str, top_k: int = 5):
    emb = get_text_embedding(query)
    results = role_collection.query(query_embeddings=[emb], n_results=top_k)
    roles = [json.loads(doc) for doc in results["documents"][0]]
    scores = results["distances"][0]
    return [{"role": r, "score": float(s)} for r, s in zip(roles, scores)]


@app.post("/roles/search_embedding")
async def api_search_roles_by_embedding(query: str, top_k: int = 5):
    """智能embedding检索角色，返回最相关top_k角色"""
    query_emb = get_text_embedding(query)
    scored = []
    for name, info in ALL_ROLES_DETAILS.items():
        emb = info.get("embedding")
        if emb:
            score = float(
                np.dot(query_emb, emb)
                / (np.linalg.norm(query_emb) * np.linalg.norm(emb) + 1e-8)
            )
            scored.append((score, name, info))
    scored.sort(reverse=True, key=lambda x: x[0])
    return {
        "roles": [
            {"name": n, "desc": i.get("desc", ""), "score": s}
            for s, n, i in scored[:top_k]
        ]
    }


