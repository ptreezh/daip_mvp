@app.post("/upload_document", response_model=DocumentUploadResponse)
async def upload_document(
    file: UploadFile = File(...),
    chunk_strategy: str = Form("auto"),
    chunk_size: int = Form(1000),
    chunk_overlap: int = Form(200),
):
    """上传并解析文档"""
    if not DOCUMENT_PARSER_AVAILABLE:
        raise HTTPException(status_code=503, detail="Document parser not available")

    try:
        # 生成任务ID
        task_id = str(uuid.uuid4())

        # 读取文件内容
        file_content = await file.read()
        file_size = len(file_content)

        logger.info(f"开始解析文档: {file.filename}, 大小: {file_size} bytes")

        # 获取文件类型
        file_type = file.filename.split(".")[-1].lower()

        # 如果使用自动配置
        if chunk_strategy == "auto":
            config = DocumentParserConfig.get_optimal_config(file_type, file_size)
            chunk_strategy = config["chunk_strategy"]
            chunk_size = config["chunk_size"]
            chunk_overlap = config["chunk_overlap"]

        # 创建解析器
        parser = DocumentParser(
            chunk_strategy=chunk_strategy,
            chunk_size=chunk_size,
            chunk_overlap=chunk_overlap,
        )

        # 解析文档
        result = parser.parse_document(file.filename, file_content)

        # 存储任务结果
        parsing_tasks[task_id] = {
            "filename": file.filename,
            "file_size": file_size,
            "status": "completed" if result.success else "failed",
            "result": result,
            "timestamp": asyncio.get_event_loop().time(),
        }

        if result.success:
            logger.info(f"文档解析成功: {file.filename}, 创建了 {len(result.chunks)} 个文本块")
            return DocumentUploadResponse(
                task_id=task_id,
                filename=file.filename,
                file_size=file_size,
                status="completed",
                message=f"文档解析成功，创建了 {len(result.chunks)} 个文本块",
            )
        else:
            logger.error(f"文档解析失败: {file.filename}, 错误: {result.error_message}")
            return DocumentUploadResponse(
                task_id=task_id,
                filename=file.filename,
                file_size=file_size,
                status="failed",
                message=f"文档解析失败: {result.error_message}",
            )

    except Exception as e:
        logger.error(f"文档上传处理失败: {e}")
        raise HTTPException(
            status_code=500, detail=f"Document processing failed: {str(e)}"
        )


@app.get("/parsing/{task_id}", response_model=DocumentParsingResponse)
async def get_parsing_result(task_id: str):
    """获取文档解析结果"""
    if task_id not in parsing_tasks:
        raise HTTPException(status_code=404, detail="Task not found")

    task = parsing_tasks[task_id]
    result = task["result"]

    if result.success:
        # 转换文本块为可序列化的格式
        chunks_data = []
        for chunk in result.chunks:
            chunks_data.append(
                {
                    "chunk_id": chunk.chunk_id,
                    "content": chunk.content,
                    "source_file": chunk.source_file,
                    "chunk_index": chunk.chunk_index,
                    "metadata": chunk.metadata,
                }
            )

        return DocumentParsingResponse(
            task_id=task_id,
            status="completed",
            message=f"解析成功，共 {len(result.chunks)} 个文本块",
            parsing_stats=result.parsing_stats,
            chunks=chunks_data,
        )
    else:
        return DocumentParsingResponse(
            task_id=task_id, status="failed", message=result.error_message
        )


