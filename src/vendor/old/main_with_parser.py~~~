    engine_id: str = "default",
):
    """获取聊天室角色推荐"""
    if engine_id not in chat_engines:
        raise HTTPException(status_code=404, detail="聊天引擎不存在")

    try:
        chat_engine = chat_engines[engine_id]

        # 获取基础推荐
        recommendations = chat_engine.get_room_recommendations(room_id, count)

        # 如果是辩论类型，进行特殊处理
        if type == "debate" and side:
            # 过滤出适合特定阵营的角色
            filtered_recommendations = []
            for rec in recommendations:
                # 这里可以根据角色的特征判断是否适合特定阵营
                # 为演示目的，简单处理
                if side == "正方" and any(
                    keyword in rec.get("specialties", [])
                    for keyword in ["支持", "积极", "正面"]
                ):
                    filtered_recommendations.append(rec)
                elif side == "反方" and any(
                    keyword in rec.get("specialties", [])
                    for keyword in ["批判", "质疑", "反对"]
                ):
                    filtered_recommendations.append(rec)
                else:
                    # 如果没有明确倾向，也可以加入
                    filtered_recommendations.append(rec)

            recommendations = filtered_recommendations[:count]

        return {
            "success": True,
            "recommendations": recommendations,
            "count": len(recommendations),
            "room_id": room_id,
            "criteria": {"side": side, "type": type, "count": count},
