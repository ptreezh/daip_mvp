class SchemaLibrary:
    def __init__(self):
        self.schemas = self._load_schemas()
        self.schema_categories = self._load_schema_categories()

    def _load_schemas(self):
        """加载现有schema库"""
        import json
        from pathlib import Path

        schemas = []
        schemas_dir = Path("schemas")

        if schemas_dir.exists():
            for domain_dir in schemas_dir.iterdir():
                if domain_dir.is_dir() and domain_dir.name != "__pycache__":
                    for schema_file in domain_dir.glob("*.json"):
                        try:
                            with open(schema_file, encoding="utf-8") as f:
                                schema_content = json.load(f)

                            schema_info = {
                                "id": f"{domain_dir.name}_{schema_file.stem}",
                                "name": schema_file.stem,
                                "domain": domain_dir.name,
                                "file_path": str(schema_file),
                                "content": schema_content,
                                "description": schema_content.get("description", ""),
                                "version": "1.0",
                                "created_at": "2024-01-01T00:00:00Z",
                                "updated_at": "2024-06-19T00:00:00Z",
                                "usage_count": 0,
                                "tags": self._extract_tags_from_schema(schema_content),
                            }
                            schemas.append(schema_info)
                        except Exception as e:
                            logger.error(f"加载schema文件失败 {schema_file}: {e}")

        return schemas

    def _extract_tags_from_schema(self, schema_content):
        """从schema内容中提取标签"""
        tags = []
        if isinstance(schema_content, dict):
            # 从属性名称中提取标签
            properties = schema_content.get("properties", {})
            for prop_name in properties.keys():
                tags.append(prop_name)

            # 从描述中提取关键词
            description = schema_content.get("description", "")
            if description:
                # 简单的关键词提取
                keywords = [
                    "financial",
                    "report",
                    "analysis",
                    "summary",
                    "data",
                    "content",
                    "academic",
                    "research",
                ]
                for keyword in keywords:
                    if keyword in description.lower():
                        tags.append(keyword)

        return list(set(tags))  # 去重

    def _load_schema_categories(self):
        """加载schema分类"""
        return {
            "financial_report": "财务报告",
            "paper_writer": "学术论文",
            "textbook_editor": "教材编辑",
            "market_analysis": "市场分析",
            "legal_document": "法律文档",
            "technical_spec": "技术规范",
            "business_plan": "商业计划",
        }


