@app.post("/schemas")
async def create_schema(schema_data: dict):
    """创建新schema"""
    import json
    from datetime import datetime
    from pathlib import Path

    # 验证必填字段
    required_fields = ["name", "domain", "content"]
    for field in required_fields:
        if field not in schema_data:
            raise HTTPException(
                status_code=400, detail=f"Missing required field: {field}"
            )

    # 生成schema ID
    schema_id = f"{schema_data['domain']}_{schema_data['name']}"

    # 创建schema记录
    new_schema = {
        "id": schema_id,
        "name": schema_data["name"],
        "domain": schema_data["domain"],
        "content": schema_data["content"],
        "description": schema_data.get("description", ""),
        "version": schema_data.get("version", "1.0"),
        "created_at": datetime.now().isoformat(),
        "updated_at": datetime.now().isoformat(),
        "usage_count": 0,
        "tags": schema_library._extract_tags_from_schema(schema_data["content"]),
    }

    # 保存到文件系统
    domain_dir = Path("schemas") / schema_data["domain"]
    domain_dir.mkdir(parents=True, exist_ok=True)

    schema_file = domain_dir / f"{schema_data['name']}.json"
    with open(schema_file, "w", encoding="utf-8") as f:
        json.dump(schema_data["content"], f, ensure_ascii=False, indent=2)

    new_schema["file_path"] = str(schema_file)

    # 添加到schema库
    schema_library.schemas.append(new_schema)

    return {"success": True, "schema_id": schema_id, "schema": new_schema}


