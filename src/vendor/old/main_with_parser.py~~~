import json
import os
import time


def load_wiki_content(entry: str) -> str:
    path = f"wiki_entries/{entry}.json"
    if not os.path.exists(path):
        return ""
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    return data.get("content", "")


def load_wiki_history(entry: str) -> list:
    path = f"wiki_entries/{entry}.json"
    if not os.path.exists(path):
        return []
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    return data.get("history", [])


def save_wiki_version(entry: str, content: str, editor: str, timestamp: str = None):
    path = f"wiki_entries/{entry}.json"
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    else:
        data = {"content": "", "history": []}
    data["content"] = content
    data["history"].append(
        {
            "version": max([v.get("version", 0) for v in data["history"]], default=0)
            + 1,
            "content": content,
            "editor": editor,
            "timestamp": timestamp or time.strftime("%Y-%m-%d %H:%M:%S"),
        }
    )
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


class WikiEntryRequest(BaseModel):
    entry: str
    content: Optional[str] = None
