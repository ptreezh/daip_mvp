class PromptOptimizationRequest(BaseModel):
    user_input: str


class PromptOptimizationResponse(BaseModel):
    insights: list[dict[str, Any]]
    structured_json: Optional[dict[str, Any]] = None
    success: bool = True
    error: Optional[str] = None


@app.post("/tools/prompt_optimization", response_model=PromptOptimizationResponse)
async def api_prompt_optimization(req: PromptOptimizationRequest):
    """两步式提示词优化：
    1. 洞察用户显性与潜在需求，按置信度高低排序（金字塔原则），不确定项放最后并加问号；
    2. 对第一步结果进行面向大模型的结构化JSON优化，聚焦首要核心需求，原子化执行，任一步失败则整体失败。
    """
    try:
        # 第一步：需求洞察与排序（可用LLM或规则，这里用简单模拟）
        user_input = req.user_input.strip()
        if not user_input:
            return PromptOptimizationResponse(
                insights=[], success=False, error="用户输入为空"
            )
        # 模拟洞察（实际可调用LLM）
        insights = []
        if "分析" in user_input:
            insights.append({"need": "文档分析", "confidence": 0.95})
        if "撰写" in user_input or "写" in user_input:
            insights.append({"need": "内容创作", "confidence": 0.9})
        if "协作" in user_input:
            insights.append({"need": "多角色协作", "confidence": 0.8})
        if not insights:
            insights.append({"need": "需求不明确？", "confidence": 0.5})
        # 按置信度排序，不确定的放最后
        insights = (
            sorted(insights, key=lambda x: -x["confidence"])
            if len(insights) > 1
            else insights
        )
        # 第二步：结构化JSON优化（聚焦首要需求）
        try:
            main_need = insights[0]["need"] if insights else "未知"
            structured_json = {
                "main_need": main_need,
                "all_needs": [i["need"] for i in insights],
                "confidence": [i["confidence"] for i in insights],
                "raw": user_input,
            }
        except Exception as e:
            return PromptOptimizationResponse(
                insights=insights, success=False, error=f"结构化失败: {e}"
            )
        return PromptOptimizationResponse(
            insights=insights, structured_json=structured_json, success=True
        )
    except Exception as e:
        return PromptOptimizationResponse(insights=[], success=False, error=str(e))


