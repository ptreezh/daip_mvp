# 工具调用嵌套深度控制

MAX_TOOL_NESTING = 1


async def call_prompt_tool(
    tool: dict, input_args: dict, request: Request = None
) -> str:
    """调用自定义提示词工具，限制嵌套深度。"""
    # 检查嵌套深度
    nesting = 0
    if request and hasattr(request.state, "tool_nesting"):
        nesting = request.state.tool_nesting
    if nesting >= MAX_TOOL_NESTING:
        return "[错误] 工具调用嵌套超过最大深度，已被系统阻止。"
    # 标记本次调用深度
    if request:
        request.state.tool_nesting = nesting + 1
    # 构造prompt并调用大模型
    prompt = tool.get("prompt", "").format(**input_args)
    # 伪代码：实际应调用本地大模型API
    result = fake_llm_infer(prompt)
    # 恢复嵌套深度
    if request:
        request.state.tool_nesting = nesting
    return result


def fake_llm_infer(prompt: str) -> str:
    # 这里仅为演示，实际应调用本地大模型
    return f"[LLM回复] {prompt}"


def clean_llm_response(response: str) -> str:
    """移除大模型输出中的思考过程、JSON/MD格式，只保留简明自然语言回复。"""
    import re

    # 移除常见的思考过程前缀
    response = re.sub(
        r"(思考过程|推理过程|分析过程|Reasoning|Thoughts|Let's think step by step).*?\n",
        "",
        response,
        flags=re.IGNORECASE | re.DOTALL,
    )
    # 移除JSON代码块
    response = re.sub(r"```json[\s\S]*?```", "", response)
    # 移除Markdown代码块
    response = re.sub(r"```[a-zA-Z]*[\s\S]*?```", "", response)
    # 移除多余空行
    response = re.sub(r"\n{2,}", "\n", response)
    return response.strip()


