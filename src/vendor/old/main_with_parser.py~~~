@app.post("/cognitive_gan/generate_conflict")
async def generate_single_conflict(request: ConflictGenerationRequest):
    """生成单个认知冲突"""
    if request.session_id not in conflict_gan_engines:
        raise HTTPException(status_code=404, detail="Session not found")

    try:
        # 转换强度
        intensity_mapping = {
            "subtle": ConflictIntensity.SUBTLE,
            "moderate": ConflictIntensity.MODERATE,
            "strong": ConflictIntensity.STRONG,
            "extreme": ConflictIntensity.EXTREME,
        }

        target_intensity = intensity_mapping.get(
            request.target_intensity.lower(), ConflictIntensity.MODERATE
        )

        # 准备上下文
        context = request.context.copy()
        context["primary_concept"] = request.primary_concept
        if request.secondary_concept:
            context["secondary_concept"] = request.secondary_concept

        # 生成冲突
        gan_engine = conflict_gan_engines[request.session_id]
        conflict = gan_engine.generator.generate_conflict(context, target_intensity)

        # 评估冲突
        evaluation = gan_engine.discriminator.evaluate_conflict(conflict)

        # 添加到数据库
        gan_engine.discriminator.add_to_database(conflict)

        return {
            "success": True,
            "conflict": {
                "id": conflict.id,
                "type": conflict.conflict_type.value,
                "intensity": conflict.intensity.name,
                "source_concept": conflict.source_concept,
                "target_concept": conflict.target_concept,
                "description": conflict.conflict_description,
                "resolution_hints": conflict.resolution_hints,
                "cognitive_load": conflict.cognitive_load,
                "creativity_potential": conflict.creativity_potential,
                "timestamp": conflict.timestamp,
            },
            "evaluation": evaluation,
        }

    except Exception as e:
        raise HTTPException(
            status_code=500, detail=f"Failed to generate conflict: {str(e)}"
        )


@app.post("/cognitive_gan/continuous_conflicts")
