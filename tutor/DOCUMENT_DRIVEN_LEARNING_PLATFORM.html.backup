<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>文档驱动学习平台 - 0代码AI规范化编程实践教学</title>
    <link rel="stylesheet" href="assets/css/unified-styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">

        .concept-card:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow-lg);
            transform: translateY(-4px);
        }

        .concept-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .concept-title {
            font-size: 24px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 12px;
        }

        .concept-description {
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .document-browser {
            background: white;
            border-radius: var(--radius);
            padding: 30px;
            box-shadow: var(--shadow);
        }

        .browser-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--border);
        }

        .search-container {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .search-input {
            flex: 1;
            padding: 12px 20px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--accent);
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .filter-btn {
            padding: 8px 16px;
            border: 2px solid var(--border);
            border-radius: 20px;
            background: white;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
            font-weight: 500;
        }

        .filter-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .filter-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
        }

        .document-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .document-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .document-card:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow);
            transform: translateY(-2px);
        }

        .document-card.related {
            border-left: 4px solid var(--success);
            background: #F0FDF4;
        }

        .document-card.highlighted {
            border-left: 4px solid var(--warning);
            background: #FFFBEB;
        }

        .document-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .document-path {
            font-size: 12px;
            color: var(--text-tertiary);
            margin-bottom: 8px;
            font-family: monospace;
        }

        .document-description {
            font-size: 14px;
            color: var(--text-secondary);
            line-height: 1.5;
            margin-bottom: 12px;
        }

        .document-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .context-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 25px;
            margin-bottom: 30px;
        }

        .context-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .context-content {
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .learning-path {
            background: white;
            border-radius: var(--radius);
            padding: 30px;
            margin-bottom: 30px;
            border: 1px solid var(--border);
        }

        .path-step {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            position: relative;
        }

        .path-step:last-child {
            margin-bottom: 0;
        }

        .path-step::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: -20px;
            width: 2px;
            background: var(--border);
        }

        .path-step:last-child::before {
            display: none;
        }

        .step-number {
            width: 40px;
            height: 40px;
            background: var(--gradient);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            flex-shrink: 0;
            z-index: 1;
        }

        .step-content {
            flex: 1;
            background: var(--surface);
            border-radius: 8px;
            padding: 20px;
        }

        .step-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .step-description {
            color: var(--text-secondary);
            margin-bottom: 15px;
        }

        .step-documents {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .step-doc-tag {
            background: white;
            color: var(--accent);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
            border: 1px solid var(--accent);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .step-doc-tag:hover {
            background: var(--accent);
            color: white;
        }

        .principle-highlight {
            background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
            border-left: 4px solid var(--accent);
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }

        .principle-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--accent);
            margin-bottom: 10px;
        }

        .principle-content {
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .view-toggle {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .view-btn {
            padding: 8px 16px;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .view-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
        }

        .loading-spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 2px solid var(--border);
            border-top: 2px solid var(--accent);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

  
        @media (max-width: 768px) {
            .container {
                padding: 0 20px;
            }

            .concept-grid {
                grid-template-columns: 1fr;
            }

            .document-grid {
                grid-template-columns: 1fr;
            }

            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <!-- 头部区域 -->
    <header class="header">
        <div class="container">
            <h1>DAIP-LIVE 文档驱动学习平台</h1>
            <p>从988份规范文档中学习规范化编程理念与上下文工程思想</p>
        </div>
    </header>

    <!-- 核心理念展示 -->
    <section class="section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">核心理念与思想体系</h2>
                <p class="section-subtitle">DAIP-LIVE项目蕴含的规范化编程哲学和上下文工程方法论</p>
            </div>

            <div class="concept-grid">
                <!-- 规范化编程 -->
                <div class="concept-card">
                    <div class="concept-icon">S</div>
                    <h3 class="concept-title">规范化编程</h3>
                    <p class="concept-description">
                        基于SOLID、TDD、KISS等核心原则，建立系统化的编程思维和代码质量标准。
                        从需求分析到代码实现，每一步都遵循明确的规范和最佳实践。
                    </p>
                </div>

                <!-- 上下文工程 -->
                <div class="concept-card">
                    <div class="concept-icon">C</div>
                    <h3 class="concept-title">上下文工程</h3>
                    <p class="concept-description">
                        深度理解业务场景，构建上下文感知的系统架构。
                        通过分层设计、接口抽象和依赖管理，实现高内聚、低耦合的代码结构。
                    </p>
                </div>

                <!-- SPEC驱动 -->
                <div class="concept-card">
                    <div class="concept-icon">D</div>
                    <h3 class="concept-title">SPEC驱动开发</h3>
                    <p class="concept-description">
                        以规格文档为指导的开发方法，确保需求、设计、实现的一致性。
                        通过详细的SPEC文档驱动整个开发流程，实现可预测、可控制的项目交付。
                    </p>
                </div>

                <!-- 逻辑一致性 -->
                <div class="concept-card">
                    <div class="concept-icon">L</div>
                    <h3 class="concept-title">逻辑一致性</h3>
                    <p class="concept-description">
                        确保从架构设计到代码实现的逻辑链条完整一致。
                        通过模块化设计和标准化接口，构建可维护、可扩展的系统架构。
                    </p>
                </div>

                <!-- 无歧义原则 -->
                <div class="concept-card">
                    <div class="concept-icon">U</div>
                    <h3 class="concept-title">无歧义原则</h3>
                    <p class="concept-description">
                        在需求分析、接口设计、代码实现等各个环节追求清晰表达。
                        通过标准化命名、详细注释和完整文档，消除理解和沟通中的歧义。
                    </p>
                </div>

                <!-- 渐进式理解 -->
                <div class="concept-card">
                    <div class="concept-icon">G</div>
                    <h3 class="concept-title">渐进式理解</h3>
                    <p class="concept-description">
                        建立从基础概念到高级应用的学习路径，通过分层设计实现知识的逐步深化。
                        每一层都建立在前一层的基础上，形成完整的知识体系。
                    </p>
                </div>
            </div>
        </div>
    </section>

  
    <!-- 文档浏览器 -->
    <section class="section">
        <div class="container">
            <div class="document-browser">
                <div class="browser-header">
                    <h2 style="font-size: 28px; font-weight: 600;">文档探索器</h2>
                </div>

                <!-- 上下文面板 -->
                <div class="context-panel">
                    <div class="context-title">
                        <span>📋</span>
                        当前学习上下文
                    </div>
                    <div class="context-content" id="contextInfo">
                        请选择一个文档开始您的学习之旅。每个文档都是DAIP-LIVE项目中规范化编程理念的具体体现。
                    </div>
                </div>

                <!-- 搜索和筛选 -->
                <div class="search-container">
                    <input type="text" class="search-input" id="searchInput" placeholder="搜索文档标题、内容或路径...">
                    <button class="filter-btn" onclick="performSearch()">搜索</button>
                </div>

                <div class="filter-buttons">
                    <button class="filter-btn active" onclick="filterByCategory('all', this)">全部文档</button>
                    <button class="filter-btn" onclick="filterByCategory('specs', this)">规格文档</button>
                    <button class="filter-btn" onclick="filterByCategory('architecture', this)">架构文档</button>
                    <button class="filter-btn" onclick="filterByCategory('process', this)">流程文档</button>
                    <button class="filter-btn" onclick="filterByCategory('compliance', this)">合规文档</button>
                    <button class="filter-btn" onclick="filterByCategory('principles', this)">编程原则</button>
                    <button class="filter-btn" onclick="filterByCategory('implementation', this)">实现细节</button>
                </div>

                <!-- 文档网格 -->
                <div class="document-grid" id="documentGrid">
                    <!-- 文档将通过JavaScript动态加载 -->
                </div>

                <div style="text-align: center; margin-top: 30px;">
                    <div class="loading-spinner" id="loadingSpinner"></div>
                    <p id="loadingText" style="color: var(--text-secondary); display: none;">正在加载文档...</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 学习路径 -->
    <section class="section" style="background: var(--surface);">
        <div class="container">
            <div class="learning-path">
                <div class="section-header" style="margin-bottom: 40px;">
                    <h2 class="section-title">基于文档的学习路径</h2>
                    <p class="section-subtitle">按照规范化编程的进阶路径，系统化学习DAIP-LIVE的核心理念</p>
                </div>

                <!-- 第一阶段：基础理解 -->
                <div class="path-step">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h3 class="step-title">基础理解 - 建立规范化思维</h3>
                        <p class="step-description">
                            从基础文档开始，理解DAIP-LIVE的设计哲学和核心原则。建立规范化的编程思维模式。
                        </p>
                        <div class="step-documents">
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('基础架构')">基础架构</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('编程原则')">编程原则</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('设计模式')">设计模式</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('最佳实践')">最佳实践</span>
                        </div>
                    </div>
                </div>

                <!-- 第二阶段：架构设计 -->
                <div class="path-step">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h3 class="step-title">架构设计 - 掌握上下文工程</h3>
                        <p class="step-description">
                            深入学习系统架构设计，理解上下文工程的核心思想。掌握模块化设计和接口抽象。
                        </p>
                        <div class="step-documents">
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('系统架构')">系统架构</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('模块设计')">模块设计</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('接口规范')">接口规范</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('依赖管理')">依赖管理</span>
                        </div>
                    </div>
                </div>

                <!-- 第三阶段：实现细节 -->
                <div class="path-step">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h3 class="step-title">实现细节 - 理解SPEC驱动开发</h3>
                        <p class="step-description">
                            学习具体的实现细节，理解如何通过规格文档驱动开发流程。掌握代码实现的规范化方法。
                        </p>
                        <div class="step-documents">
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('SPEC文档')">SPEC文档</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('实现细节')">实现细节</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('测试规范')">测试规范</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('代码质量')">代码质量</span>
                        </div>
                    </div>
                </div>

                <!-- 第四阶段：综合应用 -->
                <div class="path-step">
                    <div class="step-number">4</div>
                    <div class="step-content">
                        <h3 class="step-title">综合应用 - 融会贯通</h3>
                        <p class="step-description">
                            综合运用所学知识，理解整个DAIP-LIVE项目的理念统一性。形成自己的规范化编程方法论。
                        </p>
                        <div class="step-documents">
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('案例分析')">案例分析</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('最佳实践')">最佳实践</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('经验总结')">经验总结</span>
                            <span class="step-doc-tag" onclick="loadDocumentsByTag('未来展望')">未来展望</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 原则高亮 -->
            <div class="principle-highlight">
                <h3 class="principle-title">💡 核心学习原则</h3>
                <div class="principle-content">
                    <ul style="margin-left: 20px; margin-top: 10px;">
                        <li><strong>从文档到理解</strong>：通过阅读实际的项目文档，理解理论在实践中的应用</li>
                        <li><strong>上下文关联</strong>：理解文档之间的关联关系，建立完整的知识体系</li>
                        <li><strong>渐进式学习</strong>：从基础概念到高级应用，循序渐进地掌握核心技能</li>
                        <li><strong>实践导向</strong>：将文档中的理念转化为自己的编程实践</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <script>
        // 文档数据（模拟真实数据结构）
        const documents = [
            {
                title: "SOLID原则在DAIP-LIVE中的应用",
                path: "docs/principles/SOLID_IN_DAIP_LIVE.md",
                category: "principles",
                description: "详细分析SOLID五大原则在DAIP-LIVE项目中的具体应用，展示如何通过规范化设计提高代码质量",
                size: 15420,
                modified: "2025-12-01",
                tags: ["SOLID", "设计原则", "代码质量", "架构设计"],
                related: ["TDD_IMPLEMENTATION", "ARCHITECTURE_PATTERNS"]
            },
            {
                title: "TDD驱动开发实践指南",
                path: "docs/process/TDD_IMPLEMENTATION_GUIDE.md",
                category: "process",
                description: "全面的TDD实施指南，包括Red-Green-Refactor循环、测试策略、以及DAIP-LIVE项目中的具体实践",
                size: 28450,
                modified: "2025-11-28",
                tags: ["TDD", "测试驱动", "开发流程", "质量保证"],
                related: ["SOLID_PRINCIPLES", "CODE_REVIEW_STANDARDS"]
            },
            {
                title: "上下文工程架构设计",
                path: "docs/architecture/CONTEXT_ENGINEERING_ARCHITECTURE.md",
                category: "architecture",
                description: "深入探讨上下文工程的设计理念，如何构建感知业务场景的系统架构",
                size: 19230,
                modified: "2025-12-03",
                tags: ["上下文工程", "系统架构", "设计模式", "业务理解"],
                related: ["DOMAIN_DRIVEN_DESIGN", "MICROSERVICES_PATTERN"]
            },
            {
                title: "SPEC驱动的开发流程",
                path: "docs/specs/SPEC_DRIVEN_DEVELOPMENT.md",
                category: "specs",
                description: "详细介绍如何通过规格文档驱动整个开发流程，确保需求、设计、实现的一致性",
                size: 17650,
                modified: "2025-12-02",
                tags: ["SPEC驱动", "需求管理", "开发流程", "质量保证"],
                related: ["REQUIREMENTS_ENGINEERING", "AGILE_METHODS"]
            },
            {
                title: "P1-P8模块架构设计文档",
                path: "docs/architecture/P1_P8_MODULE_ARCHITECTURE.md",
                category: "architecture",
                description: "DAIP-LIVE项目的八个核心模块（P1-P8）的完整架构设计，包括模块职责、接口定义、依赖关系",
                size: 22480,
                modified: "2025-12-01",
                tags: ["模块架构", "P1-P8", "系统设计", "接口规范"],
                related: ["MODULE_COMMUNICATION", "DEPENDENCY_INJECTION"]
            },
            {
                title: "逻辑一致性验证标准",
                path: "docs/compliance/LOGICAL_CONSISTENCY_VALIDATION.md",
                category: "compliance",
                description: "建立系统化的一致性验证标准，确保从架构到实现的逻辑链条完整一致",
                size: 13240,
                modified: "2025-11-30",
                tags: ["逻辑一致性", "质量标准", "验证方法", "最佳实践"],
                related: ["CODE_REVIEW_CHECKLIST", "ARCHITECTURE_REVIEW"]
            }
        ];

        let currentCategory = 'all';
        let currentSearch = '';

        // 页面加载时初始化
        document.addEventListener('DOMContentLoaded', function() {
            loadDocuments();
            updateStats();
        });

        // 加载文档
        function loadDocuments(category = 'all', search = '') {
            currentCategory = category;
            currentSearch = search;

            const grid = document.getElementById('documentGrid');
            const spinner = document.getElementById('loadingSpinner');
            const loadingText = document.getElementById('loadingText');

            // 显示加载状态
            spinner.style.display = 'inline-block';
            loadingText.style.display = 'block';
            grid.innerHTML = '';

            // 模拟加载延迟
            setTimeout(() => {
                let filteredDocs = documents;

                // 按类别筛选
                if (category !== 'all') {
                    filteredDocs = filteredDocs.filter(doc =>
                        doc.category === category ||
                        doc.tags.some(tag => tag.toLowerCase().includes(category.toLowerCase()))
                    );
                }

                // 按搜索词筛选
                if (search) {
                    filteredDocs = filteredDocs.filter(doc =>
                        doc.title.toLowerCase().includes(search.toLowerCase()) ||
                        doc.description.toLowerCase().includes(search.toLowerCase()) ||
                        doc.path.toLowerCase().includes(search.toLowerCase()) ||
                        doc.tags.some(tag => tag.toLowerCase().includes(search.toLowerCase()))
                    );
                }

                renderDocuments(filteredDocs);

                // 隐藏加载状态
                spinner.style.display = 'none';
                loadingText.style.display = 'none';

                // 更新上下文信息
                updateContextInfo(category, search, filteredDocs.length);
            }, 500);
        }

        // 渲染文档
        function renderDocuments(docs) {
            const grid = document.getElementById('documentGrid');

            if (docs.length === 0) {
                grid.innerHTML = `
                    <div style="grid-column: 1/-1; text-align: center; padding: 40px;">
                        <div style="font-size: 48px; margin-bottom: 20px; opacity: 0.5;">📄</div>
                        <p style="color: var(--text-secondary);">没有找到匹配的文档</p>
                        <button class="filter-btn" onclick="loadDocuments()" style="margin-top: 20px;">查看全部文档</button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = docs.map(doc => `
                <div class="document-card ${doc.related && doc.related.length > 0 ? 'related' : ''}"
                     onclick="openDocument('${doc.path}', '${doc.title}')">
                    <h3 class="document-title">${doc.title}</h3>
                    <div class="document-path">${doc.path}</div>
                    <p class="document-description">${doc.description}</p>
                    <div class="document-meta">
                        <span>${formatFileSize(doc.size)}</span>
                        <span>${doc.modified}</span>
                    </div>
                    <div class="step-documents" style="margin-top: 12px;">
                        ${doc.tags.slice(0, 3).map(tag =>
                            `<span class="step-doc-tag" style="font-size: 11px; padding: 2px 8px;">${tag}</span>`
                        ).join('')}
                    </div>
                </div>
            `).join('');
        }

        // 更新上下文信息
        function updateContextInfo(category, search, count) {
            const contextInfo = document.getElementById('contextInfo');

            let categoryText = '';
            switch(category) {
                case 'all': categoryText = '全部文档'; break;
                case 'specs': categoryText = '规格文档'; break;
                case 'architecture': categoryText = '架构文档'; break;
                case 'process': categoryText = '流程文档'; break;
                case 'compliance': categoryText = '合规文档'; break;
                case 'principles': categoryText = '编程原则'; break;
                case 'implementation': categoryText = '实现细节'; break;
                default: categoryText = `分类: ${category}`;
            }

            let contextMessage = `当前浏览：${categoryText}`;
            if (search) {
                contextMessage += ` | 搜索: "${search}"`;
            }
            contextMessage += ` | 找到 ${count} 个文档`;

            contextInfo.textContent = contextMessage;
        }

        // 筛选功能
        function filterByCategory(category, button) {
            // 更新按钮状态
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            button.classList.add('active');

            // 加载对应类别的文档
            loadDocuments(category, currentSearch);
        }

        // 搜索功能
        function performSearch() {
            const searchInput = document.getElementById('searchInput');
            const searchTerm = searchInput.value.trim();

            loadDocuments(currentCategory, searchTerm);
        }

        // 按标签加载文档
        function loadDocumentsByTag(tag) {
            document.getElementById('searchInput').value = tag;
            loadDocuments('all', tag);

            // 滚动到文档区域
            document.querySelector('.document-browser').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        // 打开文档
        function openDocument(path, title) {
            // 这里可以实现文档的详细查看功能
            // 例如：跳转到文档详细页面、打开模态框等
            console.log(`打开文档: ${title} (${path})`);

            // 更新上下文
            const contextInfo = document.getElementById('contextInfo');
            contextInfo.innerHTML = `
                <strong>当前文档：</strong> ${title}<br>
                <strong>文档路径：</strong> ${path}<br>
                <button class="filter-btn" style="margin-top: 10px;" onclick="loadDocuments()">返回浏览</button>
            `;

            // 高亮相关文档
            highlightRelatedDocuments(path);
        }

        // 高亮相关文档
        function highlightRelatedDocuments(currentPath) {
            const currentDoc = documents.find(doc => doc.path === currentPath);
            if (currentDoc && currentDoc.related) {
                // 重新渲染文档，标记相关的
                const grid = document.getElementById('documentGrid');
                const cards = grid.querySelectorAll('.document-card');

                cards.forEach((card, index) => {
                    const doc = documents[index];
                    if (currentDoc.related.includes(doc.path)) {
                        card.classList.add('highlighted');
                    }
                });
            }
        }

        // 格式化文件大小
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        // 更新统计数据
        function updateStats() {
            // 这里可以添加真实的数据统计逻辑
            console.log('统计数据已更新');
        }

        // 搜索框回车事件
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        performSearch();
                    }
                });
            }
        });

        console.log('DAIP-LIVE 文档驱动学习平台已加载');
        console.log('核心价值：通过988份文档学习规范化编程理念与上下文工程思想');
    </script>
</body>
</html>