                        <pre><code class="language-yaml"># model-providers.yml
providers:
  openai:
    type: "openai"
    api_key: "${OPENAI_API_KEY}"
    models:
      - name: "gpt-4"
        cost_per_token: 0.00003
        max_context: 8192
        priority: "high"
      - name: "gpt-3.5-turbo"
        cost_per_token: 0.000002
        max_context: 4096
        priority: "standard"

  claude:
    type: "anthropic"
    api_key: "${ANTHROPIC_API_KEY}"
    models:
      - name: "claude-3.5-sonnet"
        cost_per_token: 0.000003
        max_context: 200000
        priority: "premium"

routing:
  strategy: "cost_optimized"
  fallbacks:
    - provider: "claude"
      model: "claude-3-haiku"
  health_check_interval: 30s</code></pre>
