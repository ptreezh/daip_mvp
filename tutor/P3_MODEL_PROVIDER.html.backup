                </div>
                <div class="code-content code-highlight">
                    <pre><code>#!/usr/bin/env python3
"""
DAIP-LIVE 模型提供商核心实现
基于 litellm 的统一 LLM 接口
"""

import asyncio
import json
from typing import Dict, Any, List, Optional
from dataclasses import dataclass
from enum import Enum

# DAIP-LIVE 依赖
from litellm import completion
from pydantic import BaseModel


class ModelProvider(Enum):
    """支持的模型提供商"""
    OLLAMA = "ollama"
    OPENAI = "openai"
    ANTHROPIC = "anthropic"
    GEMINI = "gemini"


@dataclass
class ModelConfig:
    """模型配置"""
    provider: ModelProvider
    model_name: str
    api_key: Optional[str] = None
    base_url: Optional[str] = None
    max_tokens: int = 4096
    temperature: float = 0.7


@dataclass
class ChatRequest:
    """聊天请求"""
    messages: List[Dict[str, str]]
    model: str
    max_tokens: Optional[int] = None
    temperature: Optional[float] = None
    stream: bool = False


@dataclass
class ChatResponse:
    """聊天响应"""
    content: str
    model: str
    usage: Dict[str, int]
    provider: ModelProvider


class ModelProviderManager:
    """DAIP-LIVE 模型提供商管理器"""
    
    def __init__(self):
        self.configs: Dict[str, ModelConfig] = {}
        self._load_default_configs()
    
    def _load_default_configs(self):
        """加载默认配置"""
        # Ollama 本地模型配置
        self.configs["ollama_llama2"] = ModelConfig(
            provider=ModelProvider.OLLAMA,
            model_name="llama2",
            base_url="http://localhost:11434",
            max_tokens=4096,
            temperature=0.7
        )
        
        # OpenAI 云端模型配置
        self.configs["openai_gpt4"] = ModelConfig(
            provider=ModelProvider.OPENAI,
            model_name="gpt-4",
            max_tokens=8192,
            temperature=0.7
        )
    
    async def chat(self, request: ChatRequest) -> ChatResponse:
        """统一聊天接口"""
        config = self._get_model_config(request.model)
        
        # 构建 litellm 参数
        litellm_params = {
            "model": config.model_name,
            "messages": request.messages,
            "max_tokens": request.max_tokens or config.max_tokens,
            "temperature": request.temperature or config.temperature,
            "stream": request.stream
        }
        
        # 根据提供商设置不同的参数
        if config.provider == ModelProvider.OLLAMA:
            litellm_params["api_base"] = config.base_url
        
        try:
            # 调用 litellm
            response = completion(**litellm_params)
            
            return ChatResponse(
                content=response.choices[0].message.content,
                model=config.model_name,
                usage={
                    "prompt_tokens": response.usage.prompt_tokens,
                    "completion_tokens": response.usage.completion_tokens,
                    "total_tokens": response.usage.total_tokens
                },
                provider=config.provider
            )
            
        except Exception as e:
            raise Exception(f"模型调用失败: {e}")
    
    def _get_model_config(self, model_id: str) -> ModelConfig:
        """获取模型配置"""
        if model_id not in self.configs:
            raise ValueError(f"未知的模型ID: {model_id}")
        return self.configs[model_id]
    
    def add_model(self, model_id: str, config: ModelConfig):
        """添加新模型"""
        self.configs[model_id] = config
    
    def list_models(self) -> List[Dict[str, Any]]:
        """列出所有可用模型"""
        return [
            {
                "id": model_id,
                "provider": config.provider.value,
                "model_name": config.model_name,
                "max_tokens": config.max_tokens,
                "temperature": config.temperature
            }
            for model_id, config in self.configs.items()
        ]


# 使用示例
async def main():
    """使用示例"""
    manager = ModelProviderManager()
    
    # 列出可用模型
    print("可用模型:")
    for model in manager.list_models():
        print(f"  {model['id']}: {model['provider']} - {model['model_name']}")
    
    # 发送聊天请求
    request = ChatRequest(
        messages=[
            {"role": "user", "content": "你好，请介绍一下DAIP-LIVE系统"}
        ],
        model="ollama_llama2"
    )
    
    response = await manager.chat(request)
    print(f"\n回答: {response.content}")
    print(f"模型: {response.model}")
    print(f"令牌使用: {response.usage}")


if __name__ == "__main__":
    asyncio.run(main())</code></pre>
