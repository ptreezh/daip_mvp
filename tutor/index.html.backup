<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>0代码AI规范化编程实践教学 - AI知识生成平台</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-color: #2563eb;
            --secondary-color: #7c3aed;
            --success-color: #16a34a;
            --warning-color: #ca8a04;
            --danger-color: #dc2626;
            --dark-color: #1f2937;
            --light-color: #f9fafb;
            --border-color: #e5e7eb;
            --gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: var(--gradient);
            min-height: 100vh;
            color: var(--dark-color);
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header Styles */
        .header {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: var(--gradient);
        }

        .main-title {
            font-size: 3rem;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

        .subtitle {
            font-size: 1.4rem;
            color: var(--secondary-color);
            margin-bottom: 30px;
            font-weight: 500;
        }

        /* Statistics Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .stat-card {
            background: var(--light-color);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 8px;
        }

        .stat-label {
            color: var(--dark-color);
            font-weight: 500;
            font-size: 1rem;
        }

        /* Main Content Grid */
        .content-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        /* Platform Cards */
        .platform-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            position: relative;
        }

        .platform-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 30px;
            text-align: center;
        }

        .card-icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .card-subtitle {
            font-size: 1rem;
            opacity: 0.9;
        }

        .card-content {
            padding: 30px;
        }

        .feature-list {
            list-style: none;
        }

        .feature-list li {
            padding: 8px 0;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            color: var(--dark-color);
        }

        .feature-list li::before {
            content: '✅';
            color: var(--success-color);
            font-weight: bold;
            flex-shrink: 0;
        }

        .card-footer {
            padding: 20px 30px;
            background: var(--light-color);
            border-top: 1px solid var(--border-color);
        }

        .btn {
            display: inline-block;
            padding: 12px 24px;
            background: var(--primary-color);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: background 0.3s, transform 0.3s;
            text-align: center;
            width: 100%;
        }

        .btn:hover {
            background: var(--secondary-color);
            transform: translateY(-2px);
        }

        .btn-secondary {
            background: var(--secondary-color);
        }

        .btn-secondary:hover {
            background: var(--primary-color);
        }

        /* Learning Path Section */
        .learning-paths {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .section-title {
            font-size: 2rem;
            font-weight: bold;
            color: var(--dark-color);
            margin-bottom: 30px;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }

        .paths-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .path-card {
            background: var(--light-color);
            border-radius: 12px;
            padding: 25px;
            border-left: 5px solid var(--primary-color);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .path-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .path-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 10px;
        }

        .path-duration {
            color: var(--secondary-color);
            font-weight: 500;
            margin-bottom: 15px;
        }

        .path-modules {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .module-tag {
            background: var(--primary-color);
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /* Resources Section */
        .resources-section {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .resources-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .resource-card {
            background: var(--light-color);
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            border: 2px solid var(--border-color);
            transition: border-color 0.3s, transform 0.3s;
        }

        .resource-card:hover {
            border-color: var(--primary-color);
            transform: translateY(-3px);
        }

        .resource-icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .resource-title {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--dark-color);
            margin-bottom: 10px;
        }

        .resource-count {
            color: var(--secondary-color);
            font-weight: 500;
        }

        /* Innovation Section */
        .innovation-section {
            background: white;
            border-radius: 20px;
            padding: 50px 40px;
            margin-bottom: 40px;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .innovation-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }

        .innovation-card {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 16px;
            padding: 30px;
            border: 2px solid transparent;
            background-clip: padding-box;
            position: relative;
            transition: all 0.3s ease;
        }

        .innovation-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border-radius: 16px;
            padding: 2px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .innovation-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.15);
        }

        .innovation-card:hover::before {
            opacity: 1;
        }

        .innovation-icon {
            font-size: 3rem;
            margin-bottom: 20px;
            display: block;
            text-align: center;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .innovation-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--dark-color);
            margin-bottom: 15px;
            text-align: center;
        }

        .innovation-description {
            color: #4b5563;
            margin-bottom: 20px;
            line-height: 1.7;
            text-align: center;
        }

        .innovation-features {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .innovation-features li {
            padding: 6px 0;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--dark-color);
            font-size: 0.9rem;
        }

        .innovation-features li::before {
            content: '✨';
            color: var(--secondary-color);
            font-weight: bold;
            flex-shrink: 0;
        }

        /* Footer */
        .footer {
            background: white;
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 30px;
        }

        .footer-section h3 {
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section li {
            padding: 5px 0;
        }

        .footer-section a {
            color: var(--dark-color);
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-section a:hover {
            color: var(--primary-color);
        }

        .footer-bottom {
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
            color: #6b7280;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .main-title {
                font-size: 2rem;
            }

            .subtitle {
                font-size: 1.1rem;
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

            .paths-grid {
                grid-template-columns: 1fr;
            }

            .stats-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Loading Animation */
        .loading {
            display: none;
            text-align: center;
            padding: 40px;
            color: white;
            font-size: 1.2rem;
        }

        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top: 4px solid white;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Section -->
        <header class="header">
            <h1 class="main-title">
                🎓 DAIP-LIVE 教学平台
            </h1>
            <p class="subtitle">基于988份规范文档的文档驱动学习平台 - 规范化编程理念与上下文工程思想</p>

            <div class="cta-buttons" style="margin: 2rem 0; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="DOCUMENT_DRIVEN_LEARNING_PLATFORM.html" class="btn btn-primary" style="background: var(--success); padding: 1rem 2rem; font-size: 1.1rem; font-weight: 600; color: white; text-decoration: none; border-radius: 8px; transition: transform 0.3s ease, background 0.3s ease;">
                    进入文档驱动学习平台
                </a>
                <a href="document_library.html" class="btn btn-secondary" style="background: var(--secondary); padding: 1rem 2rem; font-size: 1.1rem; font-weight: 600; color: white; text-decoration: none; border-radius: 8px; transition: transform 0.3s ease, background 0.3s ease;">
                    文档图书馆
                </a>
                <a href="progress_tracker.html" class="btn btn-secondary" style="background: var(--tertiary); padding: 1rem 2rem; font-size: 1.1rem; font-weight: 600; color: white; text-decoration: none; border-radius: 8px; transition: transform 0.3s ease, background 0.3s ease;">
                    学习进度跟踪
                </a>
            </div>

            <div class="stats-container">
                <div class="stat-card">
                    <div class="stat-number">21</div>
                    <div class="stat-label">核心模块</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">246</div>
                    <div class="stat-label">规范文档</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">1,285</div>
                    <div class="stat-label">文档关系</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">12-16</div>
                    <div class="stat-label">学习周数</div>
                </div>
            </div>
        </header>

        <!-- Project Innovation Section -->
        <section class="innovation-section">
            <h2 class="section-title">
                💡 DAIP-LIVE 项目独创性与独特意义
            </h2>
            <div class="innovation-grid">
                <div class="innovation-card">
                    <div class="innovation-icon">🏗️</div>
                    <h3 class="innovation-title">模块化P1-P8架构创新</h3>
                    <p class="innovation-description">
                        独创的模块化单体架构，通过P1(数据持久化)到P8(辩论系统)的清晰分层，避免了微服务复杂性，同时保持组件解耦。采用事件驱动的异步架构，实现真正的响应式AI系统设计。
                    </p>
                    <ul class="innovation-features">
                        <li>模块化单体架构设计</li>
                        <li>事件驱动异步处理</li>
                        <li>依赖注入容器应用</li>
                        <li>本地优先混合架构</li>
                    </ul>
                </div>

                <div class="innovation-card">
                    <div class="innovation-icon">🤝</div>
                    <h3 class="innovation-title">多模型协作机制</h3>
                    <p class="innovation-description">
                        创新的多AI模型协作系统，通过角色智能选择器和分层记忆系统，实现真正的AI团队协作。意图识别与工作流路由让交互从"命令驱动"升级为"意图驱动"。
                    </p>
                    <ul class="innovation-features">
                        <li>多模型辩论与协作</li>
                        <li>动态角色分配机制</li>
                        <li>分层记忆系统</li>
                        <li>意图识别与路由</li>
                    </ul>
                </div>

                <div class="innovation-card">
                    <div class="innovation-icon">🎯</div>
                    <h3 class="innovation-title">SPEC驱动TDD开发</h3>
                    <p class="innovation-description">
                        完整的SPEC驱动测试驱动开发体系，建立从需求规范到实现的完整流程。渐进式重构策略和向后兼容性设计，为AI应用开发提供了新的方法论参考。
                    </p>
                    <ul class="innovation-features">
                        <li>完整TDD规范体系</li>
                        <li>渐进式重构策略</li>
                        <li>AI驱动项目脚手架</li>
                        <li>向后兼容性设计</li>
                    </ul>
                </div>

                <div class="innovation-card">
                    <div class="innovation-icon">🔒</div>
                    <h3 class="innovation-title">隐私保护AI应用</h3>
                    <p class="innovation-description">
                        本地优先的设计哲学，支持完全离线运行，所有数据存储在本地。实时干预机制和透明性原则让AI系统真正"可驾驭"，为隐私敏感环境提供完整解决方案。
                    </p>
                    <ul class="innovation-features">
                        <li>完全离线能力</li>
                        <li>用户数据主权</li>
                        <li>实时干预机制</li>
                        <li>多界面统一体验</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Main Content Grid -->
        <div class="content-grid">
            <!-- Module Laboratory Card -->
            <div class="platform-card" onclick="window.location.href='enhanced_learning_platform_new.html'">
                <div class="card-header">
                    <div class="card-icon">🔬</div>
                    <h2 class="card-title">AI规范化编程实验室</h2>
                    <p class="card-subtitle">交互式模块学习环境</p>
                </div>
                <div class="card-content">
                    <ul class="feature-list">
                        <li>14个真实模块实验室</li>
                        <li>P1-P8核心模块完整覆盖</li>
                        <li>newP系列重构模块实践</li>
                        <li>学习目标和实验练习</li>
                        <li>源代码和文档关联分析</li>
                        <li>合规检查和质量评估</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="enhanced_learning_platform_new.html" class="btn">进入实验室</a>
                </div>
            </div>

            <!-- Project Replication Card -->
            <div class="platform-card" onclick="window.location.href='INTERACTIVE_LEARNING_PLATFORM_new.html'">
                <div class="card-header">
                    <div class="card-icon">🚀</div>
                    <h2 class="card-title">交互式学习平台</h2>
                    <p class="card-subtitle">完整的SPEC驱动开发指导</p>
                </div>
                <div class="card-content">
                    <ul class="feature-list">
                        <li>4个专业学习路径</li>
                        <li>5个开发阶段详细指导</li>
                        <li>246份文档系统化学习</li>
                        <li>检查清单和质量标准</li>
                        <li>评估标准和认证体系</li>
                        <li>真实项目实践体验</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="INTERACTIVE_LEARNING_PLATFORM_new.html" class="btn btn-secondary">开始学习</a>
                </div>
            </div>

            <!-- Document Quality Assessment Card -->
            <div class="platform-card" onclick="window.location.href='document_library_new.html'">
                <div class="card-header">
                    <div class="card-icon">📊</div>
                    <h2 class="card-title">智能文档库</h2>
                    <p class="card-subtitle">专业文档分析和质量监控</p>
                </div>
                <div class="card-content">
                    <ul class="feature-list">
                        <li>6维度质量评估体系</li>
                        <li>246份文档全面分析</li>
                        <li>文档关系网络可视化</li>
                        <li>版本演化趋势跟踪</li>
                        <li>质量改进建议生成</li>
                        <li>自动化质量检查工具</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="document_library_new.html" class="btn">访问文档库</a>
                </div>
            </div>

            <!-- Architecture Overview Card -->
            <div class="platform-card" onclick="window.location.href='complete_specs_tracker_new.html'">
                <div class="card-header">
                    <div class="card-icon">🏗️</div>
                    <h2 class="card-title">规格文档追踪系统</h2>
                    <p class="card-subtitle">系统架构和设计原理</p>
                </div>
                <div class="card-content">
                    <ul class="feature-list">
                        <li>模块化架构设计详解</li>
                        <li>P1-P8模块关系图</li>
                        <li>事件驱动架构原理</li>
                        <li>重构前后对比分析</li>
                        <li>设计模式和最佳实践</li>
                        <li>性能优化策略</li>
                    </ul>
                </div>
                <div class="card-footer">
                    <a href="complete_specs_tracker_new.html" class="btn btn-secondary">查看追踪系统</a>
                </div>
            </div>
        </div>

        <!-- Learning Paths Section -->
        <section class="learning-paths">
            <h2 class="section-title">
                🎯 学习路径规划
            </h2>
            <div class="paths-grid">
                <div class="path-card">
                    <h3 class="path-title">基础掌握路径</h3>
                    <p class="path-duration">⏱️ 4-6周</p>
                    <div class="path-modules">
                        <span class="module-tag">P1</span>
                        <span class="module-tag">P6</span>
                    </div>
                    <p>适合初学者，专注于数据持久化和TUI开发基础</p>
                </div>

                <div class="path-card">
                    <h3 class="path-title">核心开发路径</h3>
                    <p class="path-duration">⏱️ 6-8周</p>
                    <div class="path-modules">
                        <span class="module-tag">P2</span>
                        <span class="module-tag">P3</span>
                        <span class="module-tag">P5</span>
                    </div>
                    <p>适合有经验开发者，实现AI集成和智能引擎</p>
                </div>

                <div class="path-card">
                    <h3 class="path-title">高级特性路径</h3>
                    <p class="path-duration">⏱️ 4-6周</p>
                    <div class="path-modules">
                        <span class="module-tag">P4</span>
                        <span class="module-tag">P8</span>
                        <span class="module-tag">P7</span>
                    </div>
                    <p>高级功能开发，包括角色管理和多模型协作</p>
                </div>

                <div class="path-card">
                    <h3 class="path-title">重构精通路径</h3>
                    <p class="path-duration">⏱️ 3-4周</p>
                    <div class="path-modules">
                        <span class="module-tag">newP5</span>
                        <span class="module-tag">newP6</span>
                        <span class="module-tag">newP7</span>
                    </div>
                    <p>系统重构实践，掌握事件驱动架构和优化技巧</p>
                </div>
            </div>
        </section>

        <!-- Resources Section -->
        <section class="resources-section">
            <h2 class="section-title">
                📚 学习资源中心
            </h2>
            <div class="resources-grid">
                <div class="resource-card">
                    <div class="resource-icon">📋</div>
                    <h3 class="resource-title">规格文档</h3>
                    <p class="resource-count">69 份</p>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">🏗️</div>
                    <h3 class="resource-title">架构文档</h3>
                    <p class="resource-count">10 份</p>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">🔄</div>
                    <h3 class="resource-title">流程文档</h3>
                    <p class="resource-count">15 份</p>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">✅</div>
                    <h3 class="resource-title">合规检查</h3>
                    <p class="resource-count">9 份</p>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">🧪</div>
                    <h3 class="resource-title">测试文档</h3>
                    <p class="resource-count">14 份</p>
                </div>

                <div class="resource-card">
                    <div class="resource-icon">📊</div>
                    <h3 class="resource-title">其他文档</h3>
                    <p class="resource-count">143 份</p>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>快速链接</h3>
                    <ul>
                        <li><a href="#module-lab">模块实验室</a></li>
                        <li><a href="#replication-guide">项目复刻</a></li>
                        <li><a href="#quality-assessment">质量评估</a></li>
                        <li><a href="#architecture">架构概览</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>学习资源</h3>
                    <ul>
                        <li><a href="#">文档库</a></li>
                        <li><a href="#">API参考</a></li>
                        <li><a href="#">最佳实践</a></li>
                        <li><a href="#">常见问题</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>社区支持</h3>
                    <ul>
                        <li><a href="#">学习社区</a></li>
                        <li><a href="#">导师辅导</a></li>
                        <li><a href="#">项目展示</a></li>
                        <li><a href="#">贡献指南</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h3>关于平台</h3>
                    <ul>
                        <li><a href="#">平台介绍</a></li>
                        <li><a href="#">学习路径</a></li>
                        <li><a href="#">认证体系</a></li>
                        <li><a href="#">联系我们</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2025 DAIP-LIVE 教学平台. 基于真实项目结构的SPEC驱动开发实践教学.</p>
                <p>🚀 让学习基于真实项目，让实践创造真正价值</p>
            </div>
        </footer>

        <!-- Loading Indicator -->
        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p>正在加载...</p>
        </div>
    </div>

    <script>
        // Page load animation
        document.addEventListener('DOMContentLoaded', function() {
            // Fade in elements
            const elements = document.querySelectorAll('.platform-card, .path-card, .resource-card, .stat-card, .innovation-card');
            elements.forEach((element, index) => {
                setTimeout(() => {
                    element.style.opacity = '0';
                    element.style.transform = 'translateY(20px)';
                    element.style.transition = 'opacity 0.5s, transform 0.5s';

                    setTimeout(() => {
                        element.style.opacity = '1';
                        element.style.transform = 'translateY(0)';
                    }, 100);
                }, index * 80);
            });

            // Animate innovation cards with staggered effect
            const innovationCards = document.querySelectorAll('.innovation-card');
            innovationCards.forEach((card, index) => {
                setTimeout(() => {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(30px) scale(0.95)';
                    card.style.transition = 'opacity 0.6s, transform 0.6s';

                    setTimeout(() => {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0) scale(1)';
                    }, 150);
                }, index * 120);
            });
        });

        // Navigation functions (updated for new page structure)
        function openModuleLab() {
            window.location.href = 'enhanced_learning_platform_new.html';
        }

        function openReplicationGuide() {
            window.location.href = 'INTERACTIVE_LEARNING_PLATFORM_new.html';
        }

        function openQualityAssessment() {
            window.location.href = 'document_library_new.html';
        }

        function openArchitectureOverview() {
            window.location.href = 'complete_specs_tracker_new.html';
        }

        // Loading indicator functions
        function showLoading() {
            document.getElementById('loading').style.display = 'block';
        }

        function hideLoading() {
            document.getElementById('loading').style.display = 'none';
        }

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // 添加交互动画效果
        document.querySelectorAll('.stat-card, .platform-card, .innovation-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-8px) scale(1.05)';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });

        // 页面加载动画
        function initPageAnimations() {
            // 为卡片添加进入动画
            const cards = document.querySelectorAll('.stat-card, .platform-card, .innovation-card, .path-card, .resource-card');
            cards.forEach((card, index) => {
                card.classList.add('fade-in');
                card.style.animationDelay = `${index * 0.1}s`;
            });

            // 为统计数字添加计数动画
            const statNumbers = document.querySelectorAll('.stat-number');
            statNumbers.forEach(stat => {
                const finalValue = stat.textContent;
                if (!isNaN(parseInt(finalValue))) {
                    animateCounter(stat, 0, parseInt(finalValue), 2000);
                }
            });
        }

        // 数字计数动画
        function animateCounter(element, start, end, duration) {
            const startTime = performance.now();
            const updateCounter = (currentTime) => {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const current = Math.floor(start + (end - start) * progress);
                element.textContent = current;
                
                if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                } else {
                    element.textContent = end;
                }
            };
            requestAnimationFrame(updateCounter);
        }

        // 滚动指示器
        function initScrollIndicator() {
            const indicator = document.createElement('div');
            indicator.className = 'scroll-indicator';
            document.body.appendChild(indicator);

            window.addEventListener('scroll', () => {
                const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
                indicator.style.width = `${scrollPercent}%`;
            });
        }

        // 元素进入视口动画
        function initScrollAnimations() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-on-scroll').forEach(el => {
                observer.observe(el);
            });
        }

        // 代码块展开收起功能
        function initCodeBlockToggle() {
            document.querySelectorAll('.code-container').forEach(container => {
                const content = container.querySelector('.code-content');
                const header = container.querySelector('.code-header');
                
                if (content && content.scrollHeight > 500) {
                    const toggleBtn = document.createElement('button');
                    toggleBtn.className = 'code-toggle-btn';
                    toggleBtn.textContent = '展开';
                    toggleBtn.onclick = () => {
                        const isExpanded = content.classList.contains('expanded');
                        if (isExpanded) {
                            content.classList.remove('expanded');
                            toggleBtn.textContent = '展开';
                        } else {
                            content.classList.add('expanded');
                            toggleBtn.textContent = '收起';
                        }
                    };
                    header.appendChild(toggleBtn);
                }
            });
        }

        // 平滑滚动增强
        function initSmoothScrolling() {
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        }

        // 初始化所有动画效果
        document.addEventListener('DOMContentLoaded', function() {
            initPageAnimations();
            initScrollIndicator();
            initScrollAnimations();
            initCodeBlockToggle();
            initSmoothScrolling();
        });

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key >= '1' && e.key <= '4') {
                const cards = document.querySelectorAll('.platform-card');
                const index = parseInt(e.key) - 1;
                if (cards[index]) {
                    cards[index].click();
                }
            }
        });

        // Add tooltip functionality
        function addTooltip(element, text) {
            element.title = text;
            element.setAttribute('aria-label', text);
        }

        // Initialize tooltips
        document.querySelectorAll('.module-tag').forEach(tag => {
            const module = tag.textContent;
            const tooltips = {
                'P1': 'P1: Data Persistence - 数据持久化模块',
                'P2': 'P2: Knowledge Manager - 知识管理模块',
                'P3': 'P3: Model Provider - 模型提供者模块',
                'P4': 'P4: Role Manager - 角色管理工具模块',
                'P5': 'P5: Agent Engine - 智能执行引擎模块',
                'P6': 'P6: CLI TUI - 终端用户界面模块',
                'P7': 'P7: GUI - 图形用户界面模块',
                'P8': 'P8: Debate System - 多模型辩论系统模块',
                'newP5': 'newP5: Refactored Agent Engine - 重构后的智能引擎',
                'newP6': 'newP6: Refactored CLI TUI - 重构后的终端界面',
                'newP7': 'newP7: Refactored GUI - 重构后的图形界面'
            };

            if (tooltips[module]) {
                addTooltip(tag, tooltips[module]);
            }
        });

        console.log('🎓 DAIP-LIVE 教学平台已加载');
        console.log('📚 基于246份真实文档的专业教学平台');
        console.log('🚀 按数字键1-4可快速访问主要功能模块');
    </script>
</body>
</html>